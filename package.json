{
  "name": "rainOS",
  "version": "0.1.0",
  "description": "Kernel de sistema operativo estilo macOS escrito en React puro",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./kernel": {
      "import": "./dist/kernel/index.js",
      "require": "./dist/kernel/index.cjs"
    },
    "./bootstrap": {
      "import": "./dist/bootstrap/index.js",
      "require": "./dist/bootstrap/index.cjs"
    },
    "./bootloader": {
      "import": "./dist/bootloader/index.js",
      "require": "./dist/bootloader/index.cjs"
    },
    "./safeboot": {
      "import": "./dist/safeboot/index.js",
      "require": "./dist/safeboot/index.cjs"
    },
    "./startupinstaller": {
      "import": "./dist/startupinstaller/index.js",
      "require": "./dist/startupinstaller/index.cjs"
    },
    "./initialconfig": {
      "import": "./dist/initialconfig/index.js",
      "require": "./dist/initialconfig/index.cjs"
    },
    "./initsystem": {
      "import": "./dist/initsystem/index.js",
      "require": "./dist/initsystem/index.cjs"
    },
    "./lockscreen": {
      "import": "./dist/lockscreen/index.js",
      "require": "./dist/lockscreen/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,md}\"",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  },
  "keywords": [
    "react",
    "kernel",
    "macos",
    "window-manager",
    "desktop",
    "os",
    "rainos",
    "boot",
    "bootloader",
    "lockscreen"
  ],
  "license": "MIT",
  "author": "alexiusandromedavsgalaxia-lgtm",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexiusandromedavsgalaxia-lgtm/rainOS.git"
  },
  "bugs": {
    "url": "https://github.com/alexiusandromedavsgalaxia-lgtm/rainOS/issues"
  },
  "homepage": "https://github.com/alexiusandromedavsgalaxia-lgtm/rainOS#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
